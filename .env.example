# ==========================================
# CSF Technology Touch (csf.co.th) - Nuxt + MariaDB
# ==========================================

# Application (ตั้งเป็น https://uat.csf.co.th สำหรับพรีเซนต์ลูกค้า และเปลี่ยนเป็น https://www.csf.co.th เมื่อขึ้นระบบจริง)
NUXT_PUBLIC_SITE_URL=https://uat.csf.co.th
ADMIN_JWT_SECRET=csf-enterprise-secret-change-in-production-2026

# MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=csf_user
DB_PASSWORD=csf_password_2026
DB_NAME=csf_db

# Default Initial Admin Credentials (seeded on first boot)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=csf@2026

# LINE Official Account (Messaging API) - Optional env override (also editable in /admin/integrations)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# Facebook Page & Messenger Graph API - Optional env override (also editable in /admin/integrations)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=csf_fb_verify_2026
FB_PIXEL_ID=
