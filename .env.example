# ==========================================
# CSF Technology Touch (csf.co.th) - Nuxt + MariaDB
# ==========================================

# Application (ตั้งเป็น https://uat.csf.co.th สำหรับพรีเซนต์ลูกค้า และเปลี่ยนเป็น https://www.csf.co.th เมื่อขึ้นระบบจริง)
NUXT_PUBLIC_SITE_URL=https://uat.csf.co.th
ADMIN_JWT_SECRET=change-this-to-a-64-char-random-secret-in-production

# MariaDB Database Connection (ใส่รหัสผ่านในเครื่องหมาย Single Quote '...' เพื่อรองรับอักขระพิเศษ เช่น ^ และ !)
DB_HOST=localhost
DB_PORT=3360
DB_USER=pacific_csfnuxt
DB_PASSWORD=''
DB_NAME=pacific_csfnuxt

# Default Initial Admin Credentials (seeded on first boot, changeable at /office/security)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=csf@2026

# LINE Official Account (Messaging API) - Optional env override (also editable in /office/integrations)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# Facebook Page & Messenger Graph API - Optional env override (also editable in /office/integrations)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=csf_fb_verify_2026
FB_PIXEL_ID=
